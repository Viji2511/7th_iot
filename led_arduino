int LED1 = 8;
int LED2 = 9;
int speed = 500;

void setup() {
  pinMode(LED1, OUTPUT);
  pinMode(LED2, OUTPUT);
  Serial.begin(9600);
}

void loop() {
  if (Serial.available()) {
    String cmd = Serial.readString();
    cmd.trim();

    if (cmd == "fast")
      speed = 200;
    if (cmd == "medium")
      speed = 500;
    if (cmd == "slow")
      speed = 1000;
  }

  digitalWrite(LED1, HIGH);
  digitalWrite(LED2, LOW);
  delay(speed);

  digitalWrite(LED1, LOW);
  digitalWrite(LED2, HIGH);
  delay(speed);
}
