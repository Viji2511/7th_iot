#include <DHT.h>

#define DHTPIN 2
#define DHTTYPE DHT11

DHT dht(DHTPIN, DHTTYPE);

int rain = 3;

void setup() {
  Serial.begin(9600);
  dht.begin();
  pinMode(rain, INPUT);
}

void loop() {
  float temp = dht.readTemperature();
  int rainValue = digitalRead(rain);

  if (!isnan(temp)) {
    Serial.print("Temperature: ");
    Serial.print(temp);
    Serial.println(" C");
  }

  if (rainValue == LOW)
    Serial.println("Rain Detected");
  else
    Serial.println("No Rain");

  delay(1000);
}
